<%- include("header", {title: title}); %>

<h1>The CRUD functions: Update</h1>

<p>Edit an existing product</p>

<form method="post" action="/eshop/update">
    <strong>Product Name:</strong> <%= namn %><br>
    <input type="hidden" name="namn" value="<%= namn %>">

    <label for="pris">Price:</label>
    <input type="number" id="pris" name="pris" required><br>

    <label for="beskrivning">Description:</label>
    <input type="text" id="beskrivning" name="beskrivning"><br>

    <button type="submit">Update Product</button>
</form>

<%- include("footer"); %> 