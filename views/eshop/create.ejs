<%- include("header", {title: title}); %>

<h1>The CRUD functions: Create</h1>

<p>Add a new product to the products table</p>

<form method="post" action="/eshop/create">
    <label for="namn">Product Name:</label>
    <input type="text" id="namn" name="namn" required><br>

    <label for="pris">Price:</label>
    <input type="number" id="pris" name="pris" required><br>

    <label for="beskrivning">Description:</label>
    <input type="text" id="beskrivning" name="beskrivning"><br>

    <button type="submit">Add Product</button>
</form>

<%- include("footer"); %>