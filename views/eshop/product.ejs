<%- include("header", {title: title}); %>

<h1>Products</h1>

<p>Here is an overview of our available products</p>


<table border="1">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Product Code for products in lager</th>
        <th>Category</th>
        <th>Product available to order</th>
    </tr>
<% for (const row of res) { %>
    <tr>
        <td><%= row.produktnamn %></td>
        <td><%= row.pris %></td>
        <td><%= row.ideer %></td>
        <td><%= row.kategori %></td>
        <td class="right"><%= row.antal_i_lager %></td>
        <td>
            <a href="/eshop/delete/<%= row.produktnamn %>">Delete</a> 
            <a href="/eshop/update/<%= row.produktnamn %>">Edit</a>
        </td>
    <tr>
<% }; %>
</table>

<%- include("footer"); %>