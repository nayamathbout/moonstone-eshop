<%- include("header", {title: title}); %>

<h1>Order Information</h1>

<p>More information about the selected order</p>

<table border="1">
    <tr>
        <th>Order nummer</th>
        <th>Kund id</th>
        <th>Status tid</th>
        <th>Status</th>
        <th>Produkt kod</th>
        <th>Produkt namn</th>
    </tr>
<% for (const row of res) { %>
    <tr>
        <td><%= row.ordernummer %></td>
        <td ><%= row.kund_id %></td>
        <td ><%= row.status_tid %></td>
        <td ><%= row.status %></td>
        <td><%= row.produktkod %></td>
        <td class="right"><%= row.produktnamn %></td>
    </tr>
<% }; %>
</table>

<%- include("footer"); %>